# StreamForecast configuration. Every variable is optional; these are the defaults
# (streamforecast/config.py). An empty value counts as unset.
DATA_DIR=./data
USGS_SITE=02085000
LATITUDE=36.0711
LONGITUDE=-79.0956
TIMEZONE=America/New_York
HISTORY_START=2018-01-01
TRAIN_END=2023-12-31
CALIBRATION_START=2024-02-01
CALIBRATION_END=2024-12-31
LEADS_START=2024-01-25
USGS_LOOKBACK_DAYS=30
MAX_FFILL_DAYS=2
MAX_STALE_DAYS=2
RUN_INTERVAL_HOURS=24
RETRAIN_DAYS=7
# live | fixtures (fixtures requires AS_OF_DATE)
INGEST_SOURCE=live
# 1 | 0
MRMS_ENABLED=1
USGS_API_KEY=
HTTP_TIMEOUT_S=30
HTTP_RETRIES=3
LOG_LEVEL=INFO
# YYYY-MM-DD; fixture mode, smoke tests and CI only. Leave empty in production.
AS_OF_DATE=
DASHBOARD_PORT=8501
